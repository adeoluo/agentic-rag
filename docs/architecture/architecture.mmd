flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Client([HTTP client]):::edge
        CLI(["CLI<br/>ask, evaluate, serve"]):::edge
        Router["Router<br/>/retrieve, /metrics"]:::edge
        Validate["Validation<br/>question, hops, k"]:::control
        CLI ~~~ Client --> Router --> Validate
    end

    subgraph State["Data (in memory)"]
        direction TB
        Corpus[("Document corpus")]:::data
        Index[("Okapi BM25 index<br/>k1 1.5, b 0.75")]:::data
        Questions[("Labeled questions<br/>single and multi-hop")]:::data
        Corpus --> Index ~~~ Questions
    end

    subgraph Core["Agentic retriever"]
        direction TB
        Decompose["RuleDecomposer<br/>sub-questions"]:::core
        Retrieve["Retrieve hop<br/>BM25 top-k"]:::core
        FollowUp["Follow-up<br/>self-query on entity"]:::core
        Budget["Hop budget<br/>dedup, pivots"]:::control
        Synth["Synthesis<br/>citations, confidence"]:::core
        Budget ~~~ Decompose --> Retrieve --> FollowUp --> Synth
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Trace["Response trace<br/>sub-questions, hops"]:::obs
        Metrics["ServiceMetrics<br/>Prometheus"]:::obs
        Eval["Evaluation<br/>agentic vs single-hop"]:::obs
        Trace ~~~ Metrics ~~~ Eval
    end

    Interfaces -->|question, hops, k| Core
    State -.->|scored passages| Core
    Core -->|cited answer| Obs
