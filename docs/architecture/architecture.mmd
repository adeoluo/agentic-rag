flowchart TD
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Client(["HTTP client"]):::edge
    CLI(["CLI<br/>ask, evaluate, serve"]):::edge

    subgraph Interfaces["Service layer (stdlib HTTP, stateless)"]
        direction TB
        Router["Router<br/>/health, /ready, /retrieve, /metrics"]:::edge
        Validate["Request validation<br/>question length, max_hops, k bounds"]:::control
    end

    subgraph Loop["Agentic retriever (bounded, deterministic)"]
        direction TB
        Decompose["RuleDecomposer<br/>conjunctions and comparisons"]:::core
        Retrieve["Retrieve hop<br/>BM25 top-k per query"]:::core
        FollowUp["FollowUpGenerator<br/>self-query on a new entity"]:::core
        Budget["Hop budget and dedup<br/>max_hops, seen queries, pivots"]:::control
        Synthesize["Answer synthesis<br/>best sentence, citations, confidence"]:::core
    end

    subgraph DataPlane["Data plane (in memory)"]
        direction TB
        Corpus[("Document corpus<br/>data.py passages")]:::data
        Index[("Okapi BM25 index<br/>k1 1.5, b 0.75")]:::data
        Questions[("Labeled questions<br/>single and multi-hop")]:::data
    end

    subgraph Observability["Evaluation and observability"]
        direction TB
        Trace["Response trace<br/>sub-questions, hops, retrieved ids"]:::obs
        Metrics["ServiceMetrics<br/>per-route latency, errors, Prometheus"]:::obs
        Eval["Evaluation report<br/>agentic vs single-hop hit rate"]:::obs
    end

    Client -->|JSON request| Router
    CLI -->|ask| Decompose
    CLI -->|serve| Router
    Router --> Validate
    Validate -->|question| Decompose
    Decompose -->|sub-questions| Retrieve
    Retrieve --> FollowUp
    FollowUp -->|next query| Budget
    Budget -->|within budget| Retrieve
    FollowUp -->|ranked evidence| Synthesize
    Corpus -.->|indexed once at startup| Index
    Retrieve -.->|search| Index
    Synthesize -->|cited answer + trace| Trace
    Trace -->|JSON response| Router
    Router -.-> Metrics
    CLI -->|evaluate| Eval
    Questions -.-> Eval
    Index -.->|single-hop baseline| Eval
