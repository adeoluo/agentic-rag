---
title: System Architecture - Agentic RAG
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, system-ui, sans-serif"
    primaryColor: "#F8FAFC"
    primaryBorderColor: "#1E293B"
    primaryTextColor: "#1E293B"
    lineColor: "#64748B"
    clusterBkg: "#E2E8F0"
    clusterBorder: "#94A3B8"
---
flowchart LR
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef external fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Question([Question]):::external

    subgraph Agent["Agentic Control Loop"]
        Decompose[Decomposer]:::core
        Retrieve[Retrieve]:::core
        FollowUp[Follow-up / self-query]:::core
        Synthesize[Answer synthesis]:::core
    end

    Index[(BM25 index)]:::data

    Question --> Decompose
    Decompose -->|sub-questions| Retrieve
    Retrieve -->|query| Index
    Index -->|passages| Retrieve
    Retrieve --> FollowUp
    FollowUp -->|next hop| Retrieve
    FollowUp -->|evidence| Synthesize
    Synthesize -->|cited answer| Question
